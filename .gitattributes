*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# 下面这些是"被脚本逐行解析"的文本: 一旦混进 CR, scripts/config 会把
# "--enable X\r" 当成未知选项静默跳过 ⇒ 配置悄悄不生效。必须锁 LF。
*.fragment text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
# ★ Windows 批处理必须是 CRLF：cmd.exe 逐行解析，LF-only 会让 goto/label 与
# 括号块行为异常；同时必须是 UTF-8 无 BOM（有 BOM 时第一行 @echo off 会失效并回显）。
*.bat text eol=crlf
*.cmd text eol=crlf
